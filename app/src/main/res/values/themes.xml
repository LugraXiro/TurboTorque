<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SplashScreen" parent="Base.Theme.SplashScreen" />

    <!--Logo de la app-->
    <style name="Theme.MyApp.Splash" parent="Theme.SplashScreen">
        <!--Logo-->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- Fondo de la splashscreen -->
        <item name="windowSplashScreenBackground">@color/fondoSplashScreen</item>

        <item name="postSplashScreenTheme">@style/Base.Theme.MyApp</item>

        <!-- Barra de estado -->
        <item name="android:statusBarColor">@color/fondoPrincipal</item>
        <!-- Color de iconos de la barra (true = oscuros, false = claros) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.TurboTorque.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondoPrincipal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logogpt_turbotorquemarco</item>
        <item name="windowSplashScreenAnimationDuration">2000</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.MyApp</item>
    </style>
</resources>