<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <View
        android:id="@+id/marco"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="#F8BBD0">

    </View>

    <!-- Título opcional -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resumen del carrito"
        android:layout_below="@id/marco"
        android:textStyle="bold"
        android:textSize="20sp"
        android:padding="16dp" />

    <!-- Contenido desplazable (lista de líneas) -->
    <FrameLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtTitle"
        android:layout_above="@+id/bottomBar"
        android:paddingLeft="16dp"
        android:paddingRight="16dp" />

    <!-- Barra inferior fija -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_bar"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp">

        <!-- línea divisoria superior -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentTop="true"
            android:background="@color/divider" />

        <!-- “TOTAL” a la izquierda -->
        <TextView
            android:id="@+id/labelTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/divider"
            android:layout_alignParentStart="true"
            android:layout_marginTop="12dp"
            android:text="TOTAL"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:textSize="14sp"
            android:textColor="@android:color/black" />

        <!-- Importe a la derecha -->
        <TextView
            android:id="@+id/valueTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignBaseline="@id/labelTotal"
            android:text="500 euros"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <!-- Botón pagar anclado al borde inferior -->
        <TextView
            android:id="@+id/btnPagar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:layout_below="@id/valueTotal"
            android:gravity="center"
            android:text="Pagar"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_primary_btn" />
    </RelativeLayout>

</RelativeLayout>
