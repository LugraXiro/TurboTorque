<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@android:color/white"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_horizontal">

    <!-- Icono del producto -->
    <ImageView
        android:id="@+id/imgProducto"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="Icono producto" />

    <!-- Nombre del producto -->
    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imgProducto"
        android:layout_marginStart="6dp"
        android:text="Nombre Producto"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@android:color/black" />

    <!-- Precio unitario debajo del nombre -->
    <TextView
        android:id="@+id/txtPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtNombre"
        android:layout_alignStart="@id/txtNombre"
        android:text="Precio"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginTop="2dp" />

    <!-- Cantidad centrada -->
    <TextView
        android:id="@+id/txtCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/txtNombre"
        android:layout_marginStart="30dp"
        android:text="[cantidad] x3"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#444" />

    <!-- Precio total a la derecha -->
    <TextView
        android:id="@+id/txtTotalLinea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/txtCantidad"
        android:layout_marginStart="20dp"
        android:layout_centerVertical="true"
        android:text="precio total línea"
        android:textSize="14sp"
        android:textColor="#444" />

    <!-- Icono papelera -->
    <ImageView
        android:id="@+id/imgEliminar"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:contentDescription="Eliminar producto"
        app:tint="#F44336" />

    <!-- Línea divisoria inferior -->
    <View
        android:id="@+id/lineaInferior"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="#22000000" />
</RelativeLayout>
